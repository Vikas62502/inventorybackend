{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "exclude": [
    "node_modules",
    "node_modules*",
    "**/node_modules*",
    "dist",
    "**/*.js",
    "BACKEND_*.ts",
    "scripts/**/*.ts"
  ]
}
